<%namespace file="/modelica_language/" import="get_list"/>
within ${bldg.parent.name}.${bldg.name};
model TEASERHeatLoadCalculation${bldg.name}_HOM
  extends BESMod.Systems.BaseClasses.TEASERExport.PartialTEASERHeatLoadCalculationHOM(
    redeclare ${bldg.name}_HOM building,
    systemParameters(nZones=10,
                     QBui_flow_nominal=${get_list(bldg.room_heat_loads_list)},
                     TSetZone_nominal=${get_list(bldg.room_t_set_nominal_list)},
                     TOda_nominal=${TOda_nominal},
                     filNamWea=Modelica.Utilities.Files.loadResource("modelica://${bldg.parent.name}/Resources/${bldg.parent.weather_file_name}")));

  extends Modelica.Icons.Example;

  annotation (
    experiment(StopTime=172800,
     Interval=600,
     Tolerance=1e-06),
   __Dymola_Commands(file=
        "Resources/Scripts/Dymola/${bldg.name}/TEASERHeatLoadCalculation${bldg.name}_HOM.mos"
        "Simulate and plot"));

end TEASERHeatLoadCalculation${bldg.name}_HOM;