<%namespace file="/modelica_language/" import="get_list"/>
within ${bldg.parent.name}.${bldg.name};
model GasBoilerBuildingOnly${bldg.name}${suffix}
  extends BESMod.Systems.BaseClasses.TEASERExport.PartialGasBoilerBuildingOnlyHOM(
    redeclare ${bldg.name}${suffix} building,
## the multi family house's rooms take room-wise profiles from files,
## the HOM's AixLibHighOrderProfiles their set temperatures from a record
% if 'file_t_set' in hom_profiles:
    redeclare BESMod.Systems.UserProfiles.RoomWiseProfiles userProfiles(
        fileNameIntGains=Modelica.Utilities.Files.loadResource(
        "modelica://${bldg.parent.name}/${bldg.name}/${hom_profiles['file_internal_gains']}"),
        fileNameTSet=Modelica.Utilities.Files.loadResource(
        "modelica://${bldg.parent.name}/${bldg.name}/${hom_profiles['file_t_set']}"),
        natVent=${get_list(hom_profiles['nat_vent'])}),
% else:
    redeclare BESMod.Systems.UserProfiles.AixLibHighOrderProfiles userProfiles(
        fileNameIntGains=Modelica.Utilities.Files.loadResource(
        "modelica://${bldg.parent.name}/${bldg.name}/${hom_profiles['file_internal_gains']}"),
        gain=1,
        redeclare ${hom_profiles['t_set_profile']} TSetProfile),
% endif
    systemParameters(nZones=${len(bldg.room_heat_loads_list)},
                     QBui_flow_nominal=${get_list(bldg.room_heat_loads_list)},
                     TSetZone_nominal=${get_list(bldg.room_t_set_nominal_list)},
                     TOda_nominal=${TOda_nominal},
                     THydSup_nominal=${THydSup_nominal},
                     QBuiOld_flow_design=${QRoomOld_flow_design},
                     THydSupOld_design=${THydSupOld_design},
                     filNamWea=Modelica.Utilities.Files.loadResource("modelica://${bldg.parent.name}/Resources/${bldg.parent.weather_file_name}")));

  extends Modelica.Icons.Example;

  annotation (experiment(StopTime=172800,
     Interval=600,
     Tolerance=1e-06,
     __Dymola_Algorithm="Cvode"),
   __Dymola_Commands(file=
        "Resources/Scripts/Dymola/${bldg.name}/GasBoilerBuildingOnly${bldg.name}${suffix}.mos"
        "Simulate and plot"));

end GasBoilerBuildingOnly${bldg.name}${suffix};